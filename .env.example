# Copie para .env.local e preencha. Nunca commite o .env.local.

# Token da sua conta Apify (Settings → Integrations)
APIFY_TOKEN=

# Quem aparece nas mensagens
SENDER_NAME= 'Seu nome'
PORTFOLIO_URL= 'Link do seu portfolio'

# Banco online (Turso). Sem estas duas, o app usa o arquivo local data/lead_ouro.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Autenticação
# Segredo do Auth.js. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# E-mails que podem entrar e se cadastrar (separados por vírgula)
ALLOWED_EMAILS=seu@email.com
# Login com Google (opcional). Criar em console.cloud.google.com → APIs → Credenciais
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
